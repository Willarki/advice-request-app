@inherits LayoutComponentBase

<FluentDesignTheme @bind-Mode="@_themeMode" />

<FluentLayout>
    <FluentHeader>
        <h1 style="margin: 0; font-size: 1.5rem; color: white;">Advice Request</h1>
    </FluentHeader>
    <FluentBodyContent>
        <div class="content">
            @Body
        </div>
    </FluentBodyContent>
</FluentLayout>

@code {
    private DesignThemeModes _themeMode = DesignThemeModes.Light;
}
